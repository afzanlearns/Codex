# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codex_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_POOL_MIN=5
DB_POOL_MAX=20

# Auth
JWT_SECRET=minimum_32_character_random_string_replace_this
JWT_EXPIRES_IN=24h

# AI — Generation
GROQ_API_KEY=gsk_...

# AI — Embedding (model-swappable for H200 demo)
# Options: minilm | unixcoder | codebert
EMBEDDING_MODEL=minilm

# AI — Inference mode
# Options: groq | vllm
INFERENCE_MODE=groq
VLLM_ENDPOINT=http://localhost:8080

# RAG Configuration
CHUNK_SIZE_TOKENS=256
CHUNK_OVERLAP_TOKENS=32
TOP_K_RETRIEVAL=5
BM25_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Frontend
FRONTEND_URL=http://localhost:5173
